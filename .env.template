# Deep Researcher Configuration
# Copy this file to .env and fill in your details

# Tavily API Configuration
# Get your API key from: https://tavily.com
TAVILY_API_KEY=your-api-key-here

# Semantic Scholar API Configuration
# Get your API key from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-api-key-here

# OpenAlex API Configuration
# No API key required, but providing an email is recommended for better rate limits
OPEN_ALEX_EMAIL=your-email@example.com

# Ollama Configuration
# The local URL where Ollama is running (default is usually correct)
OLLAMA_BASE_URL=http://localhost:11434 